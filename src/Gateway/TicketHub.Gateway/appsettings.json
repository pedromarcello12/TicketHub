{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "TicketHub@SuperSecretKey#2026!MustBe32CharsMin",
    "Issuer": "TicketHub",
    "Audience": "TicketHub",
    "ExpiracaoMinutos": 60
  },
  "Cors": {
    "OrigensPermitidas": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Observabilidade": {
    "SeqUrl": "http://seq:80",
    "OtlpEndpoint": "http://localhost:4317",
    "HabilitarConsoleExporter": false
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "eventos-route": {
        "ClusterId": "eventos-cluster",
        "Match": {
          "Path": "/api/eventos/{**catch-all}"
        }
      },
      "ingressos-route": {
        "ClusterId": "ingressos-cluster",
        "Match": {
          "Path": "/api/ingressos/{**catch-all}"
        }
      },
      "pagamentos-route": {
        "ClusterId": "pagamento-cluster",
        "Match": {
          "Path": "/api/pagamentos/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "pagamento-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "http://auth-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          },
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Interval": "00:00:30"
          }
        }
      },
      "eventos-cluster": {
        "Destinations": {
          "eventos-api": {
            "Address": "http://eventos-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          },
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Interval": "00:00:30"
          }
        }
      },
      "ingressos-cluster": {
        "Destinations": {
          "ingressos-api": {
            "Address": "http://ingressos-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          },
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Interval": "00:00:30"
          }
        }
      },
      "pagamento-cluster": {
        "Destinations": {
          "pagamento-api": {
            "Address": "http://pagamento-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          },
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Interval": "00:00:30"
          }
        }
      }
    }
  }
}
